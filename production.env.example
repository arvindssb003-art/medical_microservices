# Copy to .env.production and replace every placeholder before deployment.
IMAGE_TAG=replace-with-release-version
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PUBLIC_PORT=8081

# Use the same public HTTPS issuer URL in Keycloak and in all resource services.
KEYCLOAK_ISSUER_URI=https://identity.example.com/realms/medical-shop
KEYCLOAK_SERVER_URL=https://identity.example.com
KEYCLOAK_REALM=medical-shop
KEYCLOAK_ADMIN_USERNAME=replace-with-keycloak-service-account
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-secret
KEYCLOAK_CLIENT_ID=medical-shop-client

# This first production Compose profile uses the bundled PostgreSQL instance
# and a shared application DB role; use a managed DB and per-service roles for
# a hardened production deployment.
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-a-strong-secret

RAZORPAY_KEY_ID=replace-with-production-key-id
RAZORPAY_KEY_SECRET=replace-with-production-key-secret
